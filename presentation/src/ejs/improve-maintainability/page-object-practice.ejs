<section>
  <h2 data-tags="practice">Rewrite tests with Page Objects</h2>

  i show it for the productPage, they reproduce on the login


  <app-exercise class="mt-300r fragment">
    <p>Let's code</p>
    <ul>
      <li>
        Refactor your tests to use a page object that reprensents the product page
      </li>
      <if-pw>
        <li>Create a fixture of this object</li>
      </if-pw>
    </ul>
  </app-exercise>

  <app-help class="mt-600r fragment">
    <if-pw>
      <div style="columns: 2">
        <p>Hints</p>
        <ul>
          <li>
            Create the <code>CatalogPage</code> object in
            <nobr><code>support/page-objects/catalog.page.ts</code></nobr>
            with behavioral methods
            <ul>
              <li><code>showMiniBasket()</code></li>
              <li>
                <code>addProductToBasket(produtId: number)</code>
              </li>
            </ul>
          </li>
          <li>
            Define fixtures in <nobr><code>support/fixtures.ts</code></nobr>
          </li>
        </ul>
        <p>Links</p>
        <ul>
          <li>https://playwright.dev/docs/pom</li>
          <li>https://playwright.dev/docs/test-fixtures</li>
        </ul>
      </div>
    </if-pw>
    <if-cy>
      <p>Hints</p>
      <ul>
        <li>
          Create the <code>CatalogPage</code> in
          <nobr><code>cypress/support/page-objects/catalog-page.ts</code></nobr>
        </li>
        <li>
          Add a component getter: <code>CatalogPage.miniBasketLink()</code>
        </li>
        <li>
          And behaviors:
          <ul>
            <li><code>CatalogPage.showMiniBasket()</code></li>
            <li>
              <code>CatalogPage.addProductToBasket(produtId: number)</code>
            </li>
          </ul>
        </li>
      </ul>
    </if-cy>
  </app-help>
