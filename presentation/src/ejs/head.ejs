<section class="slide--presentation-title">

  <br>
  <div class="flex justify-content-center mt-400">
    <h1>End to End Tests <br>
      {% if (nodepw) { %}
      <small class="ms-50r" style="vertical-align: middle;">with</small> Playwright
      {% } %}
      {% if (pypw) { %}
      <div class="ms-100r" style="font-size: 80%;">
        <small style="vertical-align: middle;">with</small> Playwright
        <div class="ms-150r  mt--50" style="font-size: 75%;">
          <small style="vertical-align: middle;">and </small> Python
        </div>
      </div>
      {% } %}
      {% if (cy) { %}
      <small class="ms-50r" style="line-height:inherit">with</small> Cypress
      {% } %}
    </h1>
    {% if (nodepw) { %}
    <img class="ms-200r" width="180" src="img/logo/playwright-seeklogo.svg">
    {% } %}
    {% if (pypw) { %}
    <div>
      <img class="ms-200r" width="200" src="img/logo/python.svg" style="opacity: 80%;">
      <img width="180" src="img/logo/playwright-seeklogo.svg"
        style="margin-left: -2.25em; top: 0.4em; position: relative; z-index: 1;">
    </div>
    {% } %}
    {% if (cy) { %}
    <img class="ms-200r mb-200r" width="260" src="img/logo/cypress-logo.jpeg">
    {% } %}
  </div>

  <br>

  <br>

  <p class="text-center"><small>Training course by Sébastien Boursault</small>

  <aside class="notes">
    Presentation examples : https://github.com/dzello/revealjs-themes
    https://revealjs-themes.dzello.com/robot-lung.html#/
    https://revealjs-themes.dzello.com/sunblind.html#/
  </aside>

</section>